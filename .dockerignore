# Build context excludes — keep the Docker image small and avoid leaking secrets.
node_modules
.next
.git
.gitignore

# Local env files (Railway provides env vars at runtime)
.env
.env.local
.env.development
.env.production
.env*.local
# Keep .env.example since it documents required vars

# Local DB (production uses Turso)
*.db
*.db-journal
dev.db*

# Local screenshots (production writes to a mounted volume)
/public/screenshots

# Prisma client (regenerated inside the image)
/generated/prisma

# Editor / OS noise
.DS_Store
.vscode
.idea
*.swp
*.log
/coverage
