// Portfolio Review AI — V1 schema
// One Review per submission. Feedback linked separately.
// No User model in V1 (no accounts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Review {
  id              String     @id
  createdAt       DateTime   @default(now())
  portfolioUrl    String
  targetSeniority String     @default("unspecified")
  /// Delivery style requested by the user: "chill" | "honest" | "spicy".
  /// Threads into the LLM tone dial. Default matches the pre-heat-level behavior.
  heatLevel       String     @default("honest")
  status          String     @default("pending")
  costCents       Int        @default(0)
  /// Serialized ReviewReport JSON. Null while pending/processing or after failure.
  report          String?
  failureReason   String?
  /// Classifies a failure as "system" (we broke) vs "user" (portfolio has
  /// nothing to read). Drives which copy the processing page shows.
  failureKind     String?
  /// Client IP at submission time. Used for per-IP rate limiting + admin visibility.
  ipAddress       String?
  /// Optional password for gated case studies. Set at submission, cleared the
  /// moment the crawl completes so secrets don't linger in the DB.
  casePassword    String?
  feedback        Feedback[]

  @@index([createdAt])
  @@index([status])
  @@index([ipAddress, createdAt])
}

model Feedback {
  id        String   @id
  createdAt DateTime @default(now())
  reviewId  String
  helpful   Boolean
  comment   String?
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

/// Operational errors from the agent pipeline — crawl / LLM / save failures
/// we want to review in batch rather than lose to Railway's log rotation.
/// A row is written whenever runAgent catches an unexpected exception.
model ReviewError {
  id           String   @id
  createdAt    DateTime @default(now())
  /// Which agent phase threw: "crawl", "llm", "save", "unknown".
  phase        String
  /// "system" when we broke, "user" when the portfolio has nothing we can
  /// read (admin can filter so weekly reviews focus on system issues).
  kind         String
  /// Short error message, truncated to 500 chars.
  message      String
  /// Optional review ID the error belonged to, when known.
  reviewId     String?
  /// Optional portfolio URL for triage context.
  portfolioUrl String?
  /// Admin flips this to true once the underlying bug has been addressed.
  resolved     Boolean  @default(false)

  @@index([createdAt])
  @@index([resolved, createdAt])
  @@index([kind])
}

/// Waitlist entries collected when the monthly API budget is exhausted.
/// One row per email — resubmits update the portfolioUrl in place.
model Waitlist {
  id           String   @id
  createdAt    DateTime @default(now())
  email        String   @unique
  portfolioUrl String
  /// Client IP at submission time. Used for spam signal + per-IP rate limiting.
  ipAddress    String?
  /// Admin flips this to true once we've emailed the user that we've reopened.
  notified     Boolean  @default(false)

  @@index([createdAt])
}
