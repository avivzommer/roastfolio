# =============================================================================
# Portfolio Review AI — environment variables
# Copy to .env.local for local dev. Set the same vars on your deploy platform.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Local SQLite (dev default):
DATABASE_URL=file:./dev.db
# Production options (uncomment one):
# DATABASE_URL=libsql://your-db.turso.io?authToken=...          # Turso / libSQL
# DATABASE_URL=postgres://user:pass@host:5432/dbname            # Postgres
# Note: if you switch to Postgres, also update prisma/schema.prisma datasource
# provider from "sqlite" → "postgresql" and replace the libsql adapter wiring
# in src/lib/db.ts.

# --- Admin auth ---------------------------------------------------------------
# Single password gate for the admin panel. Anything goes in dev; in prod use a
# real password.
ADMIN_PASSWORD=1029
# 32+ random bytes hex. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace-with-32-byte-hex

# --- Claude API ---------------------------------------------------------------
# Get from https://console.anthropic.com  (Settings → API Keys)
# Without this, submitReview will throw a clear error before any work happens.
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Safety nets (optional — these are the defaults) --------------------------
# Hard monthly spend cap, in cents. Defaults to 2000 ($20).
MONTHLY_BUDGET_CENTS=2000
# Max reviews per IP per hour. Defaults to 4.
IP_RATE_LIMIT_PER_HOUR=4
